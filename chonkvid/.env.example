# Copy to .env and paste the event credits key. Without a key the app runs in mock mode.
MISTRAL_API_KEY=
# auto = live when a key is present, else mock. Force with mock | live.
CHONKVID_MODE=auto

# Model IDs: confirm with `python -m chonkvid check`, which lists what this key can use.
AGENT_MODEL=ministral-8b-latest
EMBED_MODEL=mistral-embed
# The WHO agent: Le Chonk = Mistral Large 4 (mistral-large-latest is an alias of it).
WHO_MODEL=mistral-large-4

# WHO agent mode. chat = one completion with a pasted sitrep (the original path).
# agent = tools + JSON-schema structured output + the full outbreak log + the curve image.
WHO_MODE=chat
# full = every infected agent's message + each resisting agent's latest reply, in one request; sample = last 3 only.
WHO_CONTEXT=full
# 1 = also send a rendered PNG of the S/E/I/R curves to the vision encoder.
WHO_VISION=1
# Tool-calling rounds allowed before the final structured answer.
WHO_ROUNDS=2

# Throughput: match the console rate limits.
MAX_CONCURRENCY=4
MISTRAL_RPS=2

# Detector threshold for mistral-embed cosine; `probe` prints a calibrated suggestion.
EMBED_THRESHOLD=0.86

# Timestral outbreak forecast on the dashboard (local, CPU, no key). Needs
#   pip install torch https://github.com/mistralai/timestral/archive/refs/heads/main.zip
# FORECAST=0 turns it off. TIMESTRAL_MODEL: HF id (Timestral-5M | 28M | 123M | 209M)
# or a local folder holding config.json + model.safetensors.
FORECAST=1
TIMESTRAL_MODEL=mistralai/Timestral-209M
FORECAST_MIN_TICKS=3
# Forecasts made at these ticks are scored against the real curve at the end of a run.
FORECAST_CHECK_TICKS=2,5

# ---------------------------------------------------------------------------
# Optional Supabase persistence (Covid19-sim backend). Default is local-only:
# existing JSONL recordings keep working with none of these set.
# ---------------------------------------------------------------------------
# local | supabase
PERSISTENCE_BACKEND=local
# TLS PostgreSQL connection for CLI writers and legacy import.
# Use the Supavisor pooler, not db.<ref>.supabase.co: the direct host is IPv6-only and
# fails to resolve on IPv4-only networks. Port 5432 = session mode, 6543 = transaction mode.
# Example: postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
# (percent-encode special characters in the password). Or set the split fields instead:
# SUPABASE_DB_HOST=aws-0-eu-central-1.pooler.supabase.com
# SUPABASE_DB_USER=postgres.<ref>
# SUPABASE_DB_PASSWORD=
DATABASE_URL=
# Which simulation model dashboard runs belong to until the architecture is final.
SIMULATION_TYPE=prompt_injection

# Supabase project (https://...). Required when PERSISTENCE_BACKEND=supabase.
SUPABASE_URL=
# Publishable/anon key - safe for browsers, constrained by RLS.
SUPABASE_ANON_KEY=
# SECRET service-role key - SERVER ONLY, bypasses RLS. Never commit or ship it.
SUPABASE_SERVICE_ROLE_KEY=

# Recommended for remote mirroring: use an existing matching project/scenario pair.
# Remote reads and mirroring require a signed-in Supabase user's access token.
# Enter a signed-in user access token in the dashboard for shared replay.
# SUPABASE_PROJECT_ID=
# SUPABASE_SCENARIO_ID=
# Bootstrap values when the IDs above are omitted. For HTTP/WS bootstrap, provision
# a confirmed Auth account with this email and use its own access token.
# Authenticated mirror recordings go to the private/ subdirectory of the runs folder.
# SUPABASE_PROJECT_NAME=covid19-sim
# SUPABASE_SERVICE_EMAIL=system@covid19-sim.local
# SUPABASE_SERVICE_PASSWORD=
